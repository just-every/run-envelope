{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck",
        "pnpm run test:typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "ENVELOPE_JOURNEYS=records,allocations,schedules,pay-items,rules,approvals,identity pnpm run test:runtime"
      ]
    },
    {
      "name": "custody",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "ENVELOPE_JOURNEYS=sponsored pnpm run test:runtime"
      ]
    },
    {
      "name": "people",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "ENVELOPE_JOURNEYS=income-verification,source-intake,leave pnpm run test:runtime"
      ]
    }
  ],
  "nightly": []
}
