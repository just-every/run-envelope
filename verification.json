{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck",
        "pnpm run test:typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "ENVELOPE_JOURNEYS=records,allocations,schedules,pay-items,rules,approvals,sponsored,identity,leave,source-intake,income-verification pnpm run test:runtime"
      ]
    },
    {
      "name": "firm",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "ENVELOPE_JOURNEYS=firm pnpm run test:runtime"
      ]
    }
  ],
  "nightly": []
}
