{
  "schemaVersion": 1,
  "id": "just-every/envelope",
  "identityKind": "project",
  "toolchain": {
    "id": "runeditrun/edition-authoring",
    "version": "1.1.0"
  },
  "components": [
    {
      "id": "just-every/envelope",
      "role": "edition",
      "source": {
        "kind": "local",
        "paths": [
          "src/auth.server.ts",
          "src/server.ts",
          "src/identity.ts",
          "src/routes",
          "src/site",
          "scripts/installer",
          "src/demo.ts",
          "src/envelope",
          "src/ui"
        ]
      }
    },
    {
      "id": "runeditrun/base",
      "role": "foundation",
      "source": {
        "kind": "local",
        "paths": [
          "src/base"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "91c082876d6560150f3dc012ec57b92bd9895228",
          "paths": [
            "foundation/runtime"
          ]
        }
      }
    },
    {
      "id": "runeditrun/ai",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/ai"
        ]
      }
    },
    {
      "id": "runeditrun/demo",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/demo"
        ]
      }
    },
    {
      "id": "runeditrun/dependencies",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/dependencies"
        ]
      }
    },
    {
      "id": "runeditrun/mail",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/mail"
        ]
      }
    },
    {
      "id": "runeditrun/operator-auth",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/operator-auth"
        ]
      }
    },
    {
      "id": "runeditrun/owner-claim",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/owner-claim"
        ]
      }
    },
    {
      "id": "runeditrun/edition-authoring",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "scripts/edition-authoring"
        ]
      }
    },
    {
      "id": "just-every/envelope-adapted-foundation",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          ".github/workflows/verify.yml",
          "src/mail.server.mjs",
          "tests/incremental-typecheck.test.mjs",
          "verification.json"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "91c082876d6560150f3dc012ec57b92bd9895228",
          "paths": [
            "export/verify.yml",
            "foundation/template/src/mail.server.mjs",
            "foundation/template/tests/incremental-typecheck.test.mjs",
            "foundation/template/verification.json"
          ]
        },
        "mappings": [
          {
            "path": ".github/workflows/verify.yml",
            "originPath": "export/verify.yml"
          },
          {
            "path": "src/mail.server.mjs",
            "originPath": "foundation/template/src/mail.server.mjs"
          },
          {
            "path": "tests/incremental-typecheck.test.mjs",
            "originPath": "foundation/template/tests/incremental-typecheck.test.mjs"
          },
          {
            "path": "verification.json",
            "originPath": "foundation/template/verification.json"
          }
        ]
      }
    },
    {
      "id": "just-every/envelope-delivery-setup",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "scripts/delivery/base/setup-manifest.mjs"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "4280971d7c0295b8a88c3e1179048efcbbe14f30",
          "paths": [
            "modules/delivery-producer/setup-manifest.mjs"
          ]
        },
        "mappings": [
          {
            "path": "scripts/delivery/base/setup-manifest.mjs",
            "originPath": "modules/delivery-producer/setup-manifest.mjs"
          }
        ]
      }
    }
  ]
}
